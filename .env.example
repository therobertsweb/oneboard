SECRET_KEY=change-this-secret
HOST=127.0.0.1
PORT=5002
FLASK_DEBUG=0

# Required to activate email verification for new accounts. Set every value
# except SMTP_USE_TLS; never commit the resulting .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave GOOGLE_REDIRECT_URI empty so the app derives the OAuth callback from
# the public URL of each request (works behind Cloudflare tunnels and reverse
# proxies). Copy the exact "Redirect URI" shown in Settings -> Google Search
# Console into the Google Cloud Console "Authorized redirect URIs" list.
# Set a fixed value only when serving from a single stable domain.
GOOGLE_REDIRECT_URI=
# The native macOS app uses an OAuth Desktop client and a private loopback
# callback on its dynamically selected localhost port. Do not configure it here.

# Windows example:
ONEBOARD_SITE_DIRECTORY=C:\Sites\example.com

# Do not store your Muse API key here. Each user adds their own key in Settings -> Muse API.
